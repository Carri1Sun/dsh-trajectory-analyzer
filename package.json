{
 "name": "dsh-step-summary",
 "version": "1.0.0",
 "type": "module",
 "description": "Manual per-step input-context and output summaries for DeepSeek Harness trajectories.",
 "exports": {
  ".": "./index.js",
  "./client": "./client.js",
  "./locale/*.json": "./locale/*.json",
  "./icon": "./icon.svg"
 },
 "files": [
  "index.js",
  "core.js",
  "client.js",
  "cordis.patch.yml",
  "locale/*.json",
  "icon.svg"
 ],
 "dependencies": {
  "zod": "4.6.7"
 },
 "dsh": {
  "bundle": {
   "patch": "./cordis.patch.yml"
  },
  "client": {
   "platform": "web",
   "immediately": true,
   "inject": [
    "@deepseek-ai/dsh-client-ui-conversation"
   ]
  }
 },
 "license": "MIT",
 "repository": {
  "type": "git",
  "url": "git+https://github.com/Carri1Sun/dsh-trajectory-analyzer.git"
 },
 "homepage": "https://github.com/Carri1Sun/dsh-trajectory-analyzer",
 "keywords": [
  "deepseek-harness",
  "dsh",
  "plugin",
  "trajectory",
  "summary",
  "deepseek-flash"
 ],
 "scripts": {
  "test": "node core.test.mjs && node integration.test.mjs && node client.test.mjs"
 }
}